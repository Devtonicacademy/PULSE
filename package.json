{
  "name": "pulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js --dev",
    "build": "next build",
    "start": "node server.js",
    "test:rules": "firebase emulators:exec --only firestore --project pulse-rules-test \"node --test --test-concurrency=1 tests/firestore.rules.test.mjs tests/moderation.rules.test.mjs\"",
    "emulators": "firebase emulators:start --only firestore,auth --project quizapp-project-c5e0e",
    "test:server": "node --test tests/photos.server.test.mjs tests/coverage.server.test.mjs tests/geo.server.test.mjs",
    "test": "npm run test:unit && npm run test:server && npm run test:rules",
    "test:unit": "node --test tests/sunLight.test.mjs tests/onboarding.test.mjs tests/tilePriority.test.mjs tests/typing.test.mjs tests/location.test.mjs tests/hubFollow.test.mjs tests/fixTracker.test.mjs tests/locationStrategy.test.mjs tests/tileGeometry.test.mjs tests/osmTags.test.mjs tests/osmBuild.test.mjs tests/roofShapes.test.mjs tests/obstacles.test.mjs tests/streetRouting.test.mjs tests/seedData.test.mjs tests/routes.test.mjs",
    "dev:emulator": "node --env-file=.env.emulator server.js --dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "aws4fetch": "^1.0.20",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "framer-motion": "^14.4.0",
    "geofire-common": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^5.2.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.0.2",
    "three": "^0.186.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "draco3dgltf": "^1.5.7",
    "firebase-tools": "^13.35.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
