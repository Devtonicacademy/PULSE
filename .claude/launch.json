{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pulse-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--open=false"
      ],
      "port": 3000
    },
    {
      "name": "pulse-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.PORT='4173'; import('./server.js')"
      ],
      "port": 4173
    },
    {
      "name": "pulse-emulator",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--mode",
        "emulator",
        "--port",
        "3100",
        "--open=false"
      ],
      "port": 3100
    }
  ]
}